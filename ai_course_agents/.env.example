# Скопируйте этот файл в .env и впишите ключ. Файл .env в git не попадает.

# Обязательно: ключ DeepSeek API (https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# Необязательно — значения по умолчанию указаны справа
# LLM_MODEL=deepseek/deepseek-flash      # или deepseek/deepseek-v4-pro
# PRICE_IN_RUB=30                        # ₽ за миллион входных токенов
# PRICE_OUT_RUB=120                      # ₽ за миллион выходных токенов
# MAX_LLM_CALLS=12                       # предохранитель: запросов к LLM на один ответ
# MAX_CONCURRENT_RUNS=8                  # одновременных прогонов агента на процесс
# JWT_SECRET=                            # если пусто — сгенерируется в data/.jwt_secret
# JWT_TTL_HOURS=168
# HOST=127.0.0.1
# PORT=8000
# POI_DB=../week2/practice/poi.sqlite
# DATA_DIR=./data
